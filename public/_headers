/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: https:; style-src 'self'; script-src 'self'; connect-src 'self'; font-src 'self' data:

/search-index.json
  Cache-Control: public, max-age=300

/theme.css
  Cache-Control: no-store

/assets/site-header.css
  Cache-Control: public, max-age=300

/assets/site.css
  Cache-Control: public, max-age=300

/assets/base.css
  Cache-Control: public, max-age=300
